// LOCAL DEVELOPMENT ONLY.
// This mirrors prisma/schema.prisma but uses a zero-setup SQLite file so you
// can run the app locally without a Postgres server. Production (Vercel) uses
// prisma/schema.prisma (PostgreSQL). Keep the models below in sync with it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Ledger {
  id        String    @id @default(cuid())
  name      String
  nameKey   String    @unique
  passHash  String
  recoveryHash String?
  monthlyBudget Float?
  // Per-space UI preferences (JSON blob), synced across devices.
  settings  Json?
  createdAt DateTime  @default(now())
  expenses  Expense[]
  resetRequests ResetRequest[]
}

model ResetRequest {
  id            String    @id @default(cuid())
  ledgerId      String
  ledger        Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ticketHash    String    @unique
  proposedHash  String
  questionnaire String
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([ledgerId])
  @@index([status])
}

model Expense {
  id       String @id @default(cuid())
  ledgerId String
  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  title    String
  category String
  amount   Float
  paidBy   String
  date     DateTime
  notes    String?
  paymentMode   String?
  paymentDetail String?
  // Tiny base64 JPEG thumbnail of a scanned bill (capped ~10KB). Preview only.
  thumbnail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ledgerId, date])
}
