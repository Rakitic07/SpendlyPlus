generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A Ledger is one person's private space, unlocked by a passphrase.
model Ledger {
  id        String    @id @default(cuid())
  // Case-insensitive uniqueness is enforced in application code via nameKey.
  name      String
  nameKey   String    @unique
  // bcrypt hash of the passphrase. Never store the raw passphrase.
  passHash  String
  // bcrypt hash of the one-time recovery code shown at signup. Lets an owner
  // reset their own passphrase without an admin. Null for legacy spaces.
  recoveryHash String?
  // Optional recurring monthly budget goal, synced across devices.
  monthlyBudget Float?
  // Per-space UI preferences (JSON blob), synced across devices. Null until the
  // owner changes any setting; clients fall back to defaults when absent.
  settings  Json?
  createdAt DateTime  @default(now())
  expenses  Expense[]
  resetRequests ResetRequest[]
}

// An owner-initiated, admin-approved passphrase reset. The owner proposes their
// new passphrase (stored only as a bcrypt hash) and receives a ticket code to
// check status. Nothing changes until an admin verifies the questionnaire
// against the real data and approves — then the proposed hash becomes active.
model ResetRequest {
  id            String    @id @default(cuid())
  ledgerId      String
  ledger        Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  // sha256 of the high-entropy ticket code (used for status lookup).
  ticketHash    String    @unique
  // bcrypt hash of the new passphrase the owner wants to set.
  proposedHash  String
  // JSON blob of identifying answers the owner supplied (no secrets).
  questionnaire String
  status        String    @default("pending") // pending | approved | rejected
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([ledgerId])
  @@index([status])
}

model Expense {
  id        String   @id @default(cuid())
  ledgerId  String
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  title     String // e.g. "Sabji", "Petrol"
  category  String // e.g. "Grocery", "Bills"
  amount    Float
  paidBy    String
  date      DateTime // the day the expense happened
  notes     String?
  // How it was paid. paymentMode is one of Cash/UPI/Card; paymentDetail is the
  // provider/bank (e.g. "Google Pay", "HDFC") or a custom value. Both optional.
  paymentMode   String?
  paymentDetail String?

  // Optional TINY thumbnail (base64 JPEG data URL, capped ~10KB) of a scanned
  // bill, kept only for a small preview when editing. The full photo is never
  // stored anywhere — not the DB, not the device.
  thumbnail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ledgerId, date])
}
