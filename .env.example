# ----------------------------------------------------------------------------
# Spendly-Plus environment variables
# Copy this file to `.env` (local) and set the same values in Vercel Project
# Settings -> Environment Variables (Production + Preview).
# NEVER commit the real .env file. It is git-ignored.
# ----------------------------------------------------------------------------

# PostgreSQL connection string — used in PRODUCTION (Vercel) only.
# Local development uses a zero-setup SQLite file instead, so you can leave this
# as-is (or empty) when running locally.
# For production: create a free Postgres DB on https://neon.tech (or the Vercel
# "Storage" tab) and set this in Vercel -> Settings -> Environment Variables.
#
# IMPORTANT (serverless): use the POOLED connection string (Neon's host contains
# "-pooler") and append `pgbouncer=true` — without it Prisma hits intermittent
# "prepared statement already exists" errors under the transaction pooler.
# `connection_limit=1` keeps each serverless instance from hoarding connections.
# Example (pooled):
#   postgresql://user:pass@ep-xxx-pooler.<region>.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT (non-pooled) connection — used ONLY by `prisma migrate` / `db push`.
# Same as DATABASE_URL but the DIRECT host (remove "-pooler") and no pgbouncer flag.
# Set this in Vercel too so the build's `prisma generate` and any migrations work.
# Example (direct):
#   postgresql://user:pass@ep-xxx.<region>.aws.neon.tech/db?sslmode=require
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies (JWT). Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Deployed site the native (Capacitor) app loads. Only needed when building the
# APK/iOS app with `make android` / `make ios`. Safe to expose (it's just a URL).
CAP_SERVER_URL="https://your-app.vercel.app"

# OCR.space API key — powers accurate web/PWA bill scanning via /api/ocr.
# Get a free key at https://ocr.space/ocrapi (free tier ~25k requests/month).
# When unset, web scanning falls back to slower, less accurate on-device OCR.
OCRSPACE_API_KEY="helloworld"
